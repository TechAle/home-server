# Copy this file to server/.env and fill in the values:
#   cp server/.env.example server/.env
#
# server/.env is ignored by git and must never be committed.
# The non-secret settings (API URL, client ID, redirect URI) stay in
# server/configuration.json.

# AniList OAuth client secret.
# Create/manage the API client at https://anilist.co/settings/developer
# You can regenerate the secret there if it has been exposed.
ANILIST_CLIENT_SECRET=

# AniList OAuth access token (starts with "eyJ..." and is valid for one year).
# Generate it with the AniList OAuth flow (authorization code -> token).
ANILIST_ACCESS_TOKEN=

# Static key required by POST /auth/register. Pick a long random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Leave it empty to disable registration.
REGISTRATION_KEY=

# Optional: where the SQLite database lives.
# Default: server/data/home-server.db
# DATABASE_PATH=

# Optional: how many days a session token stays valid. Default: 30.
# SESSION_TTL_DAYS=30
